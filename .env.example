# Admin credentials (server-side)
YS_UR=admin
YS_PD=supersecret

# Postgres (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shaheen_db
DATABASE_URL=postgres://postgres:postgres@db:5432/shaheen_db

# Server secret (server only)
SERVER_JWT_SECRET=replace_with_strong_secret

# Runtime / Platform
MAX_CONCURRENT_TASKS_YS=4
LOG_LEVEL_YS=info
TZ_YS=UTC
START_FROM_LATEST_YS=true

# Gateway configuration (example variables)
GATEWAY_URL_YS=https://gateway.example.com
GATEWAY_API_KEY_YS=
GATEWAY_TIMEOUT_YS=30

# AI / Integrations (frontend variables must start with VITE_ if accessed by client)
VITE_OPENROUTER_API_KEY=
VITE_TELEGRAM_BOT_TOKEN=
VITE_TAVILY_API_KEY=
VITE_XAI_API_KEY=
VITE_OPENAI_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_GROQ_API_KEY=
VITE_GEMINI_API_KEY=
VITE_EXA_API_KEY=
VITE_FIRECRAWL_API_KEY=
VITE_ELEVENLABS_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_GOOGLE_SEARCH_API_KEY=
VITE_GOOGLE_SEARCH_ENGINE_ID=

# Multiple keys for same provider
VITE_GROQ_API_KEY1=
VITE_GROQ_API_KEY2=
VITE_GROQ_API_KEY3=
